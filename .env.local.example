# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- LemonSqueezy ------------------------------------------------------------
# Settings -> API in your LemonSqueezy dashboard.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Settings -> Webhooks -> Signing secret (create a webhook pointed at
# /api/webhooks/lemonsqueezy once the app is deployed).
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs for the three paid actions (create these as products/variants
# in LemonSqueezy: Boost $5, Revive $10, Defend the Throne $20).
LEMONSQUEEZY_BOOST_VARIANT_ID=
LEMONSQUEEZY_REVIVE_VARIANT_ID=
LEMONSQUEEZY_DEFEND_VARIANT_ID=
# Variant IDs for the three sponsorship durations (create these as
# products/variants too: 7 Days $5, 14 Days $10, 30 Days $15).
LEMONSQUEEZY_SPONSOR_7_VARIANT_ID=
LEMONSQUEEZY_SPONSOR_14_VARIANT_ID=
LEMONSQUEEZY_SPONSOR_30_VARIANT_ID=

# --- Admin -------------------------------------------------------------------
# Shared secret for /admin/sponsorships (no account system exists, so this
# is the only gate — pick a long random string and never commit the real
# value). Sent as the `x-admin-secret` header on every admin request.
ADMIN_SECRET=

# --- Anti-abuse ----------------------------------------------------------------
# Any random string, used to salt the hashed voter fingerprint. Set a real
# value in production; a dev default is used if this is left blank.
FINGERPRINT_SALT=

# --- App ---------------------------------------------------------------------
# Public base URL, used for embed badge links and checkout redirects.
# e.g. http://localhost:3000 in dev, https://your-app.vercel.app in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
